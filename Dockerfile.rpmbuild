# syntax=docker/dockerfile:1
ARG BASE_IMAGE=fedora:43
FROM ${BASE_IMAGE}
RUN dnf -y install rpm-build rpmdevtools redhat-rpm-config findutils tar gzip rsync python3 python3-devel python3-poetry-core python3-pytest pyproject-rpm-macros python3-rpm-macros && dnf clean all
RUN cat > /usr/local/bin/build-rpm <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
SRC=${SRC:-/src}; WORKROOT=${WORKROOT:-/work}; OUT=${OUT:-/out}; WORK=${WORKROOT}/src
rm -rf "$WORK"; mkdir -p "$WORK" "$OUT"
rsync -a --delete --exclude .git --exclude .venv --exclude dist --exclude build --exclude __pycache__ --exclude .pytest_cache "$SRC/" "$WORK/"
cd "$WORK"
ver=${VERSION:-$(python3 - <<'PY'
import tomllib
print(tomllib.load(open('pyproject.toml','rb'))['project']['version'])
PY
)}
TOPDIR="$WORKROOT/rpmbuild"; mkdir -p "$TOPDIR"/{BUILD,BUILDROOT,RPMS,SOURCES,SPECS,SRPMS}
SOURCE_STAGE=$(mktemp -d "$WORKROOT/source.XXXXXX")
mkdir -p "$SOURCE_STAGE/heckle-$ver"
rsync -a "$WORK/" "$SOURCE_STAGE/heckle-$ver/"
tar -C "$SOURCE_STAGE" -czf "$TOPDIR/SOURCES/heckle-$ver.tar.gz" "heckle-$ver"
cp rpm/heckle.spec "$TOPDIR/SPECS/"
rpmbuild -ba "$TOPDIR/SPECS/heckle.spec" --define "_topdir $TOPDIR" --define "upstream_version $ver"
shopt -s nullglob
cp -v "$TOPDIR"/RPMS/*/*.rpm "$TOPDIR"/SRPMS/*.src.rpm "$OUT/"
EOF
RUN chmod +x /usr/local/bin/build-rpm
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/build-rpm"]
